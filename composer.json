{
  "name": "socialintegrations/social-integrations",
  "description": "Share WordPress content to social networks, with AI captions and a content calendar.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=7.4"
  },
  "require-dev": {
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "SocialIntegrations\\": "backend/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.33"
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "compat": "phpcs -p includes social-integrations.php uninstall.php --standard=PHPCompatibilityWP --runtime-set testVersion 7.4-"
  }
}
