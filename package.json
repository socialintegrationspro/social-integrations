{
  "name": "social-integrations",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-2.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && tsc -p frontend/editor/tsconfig.json --noEmit && vite build && vite build -c vite.editor.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p frontend/editor/tsconfig.json --noEmit",
    "check:self-contained": "node scripts/assert-self-contained.mjs",
    "dev:editor": "vite build -c vite.editor.config.ts --watch"
  },
  "dependencies": {
    "@fontsource/plus-jakarta-sans": "^5.2.6",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
