<?xml version="1.0"?>
<ruleset name="Social Integrations">
	<file>./social-integrations.php</file>
	<file>./uninstall.php</file>
	<file>./backend</file>
	<arg name="extensions" value="php"/>
	<arg value="sp"/>
	<config name="testVersion" value="7.4-"/>
	<config name="minimum_wp_version" value="6.3"/>
	<rule ref="WordPress">
		<!-- PSR-4 file names (Plugin.php), not class-plugin.php. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="social-integrations"/>
		</properties>
	</rule>
	<rule ref="PHPCompatibilityWP"/>
</ruleset>
